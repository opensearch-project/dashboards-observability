{
  "name": "observability-dashboards",
  "version": "3.9.0.0",
  "main": "index.ts",
  "license": "Apache-2.0",
  "scripts": {
    "osd": "node ../../scripts/osd",
    "build": "yarn plugin-helpers build",
    "test": "../../node_modules/.bin/jest --config ./test/jest.config.js",
    "cypress:run": "TZ=America/Los_Angeles ../../node_modules/cypress/bin/cypress run",
    "cypress:open": "TZ=America/Los_Angeles ../../node_modules/cypress/bin/cypress open",
    "plugin-helpers": "node ../../scripts/plugin_helpers",
    "prepare": "husky install",
    "lint:es": "node ../../scripts/eslint",
    "lint": "yarn lint:es",
    "cypress:parallel": "cypress-parallel -s cypress:run -t 2 -d .cypress/integration"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      ".husky/hooks/check-test-only.sh",
      "yarn lint --fix"
    ]
  },
  "dependencies": {
    "@algolia/autocomplete-core": "^1.4.1",
    "@algolia/autocomplete-theme-classic": "^1.2.1",
    "@egjs/hammerjs": "^2.0.17",
    "@nteract/outputs": "^3.0.11",
    "@nteract/presentational-components": "^3.4.3",
    "@reduxjs/toolkit": "^1.6.1",
    "ajv": "^8.18.0",
    "antlr4": "4.8.0",
    "antlr4ts": "^0.5.0-alpha.4",
    "echarts": "^6.0.0",
    "isomorphic-dompurify": "~2.29.0",
    "json5": "^2.2.3",
    "mime": "^3.0.0",
    "performance-now": "^2.1.0",
    "plotly.js-dist": "^2.35.3",
    "react-graph-vis": "^1.0.7",
    "react-paginate": "^8.1.3",
    "react-plotly.js": "^2.6.0",
    "redux-persist": "^6.0.0",
    "vis-data": "^7.1.2",
    "vis-network": "^9.1.13",
    "vis-util": "^5.0.7",
    "sanitize-filename": "^1.6.3"
  },
  "devDependencies": {
    "@cypress/skip-test": "^2.6.1",
    "@types/mime": "^3.0.1",
    "@types/react-plotly.js": "^2.6.4",
    "@types/sanitize-filename": "^1.6.3",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "cypress-multi-reporters": "^1.6.4",
    "cypress-parallel": "^0.15.0",
    "cypress-watch-and-reload": "^1.10.6",
    "husky": "^8.0.3",
    "jest-dom": "^4.0.0",
    "lint-staged": "^15.2.10"
  },
  "resolutions": {
    "**/mocha/**/minimatch": "^10.1.1",
    "ansi-regex": "^5.0.1",
    "diff": "^8.0.4",
    "react-syntax-highlighter": "^15.4.3",
    "prismjs": "^1.30.0",
    "trim": "^1.0.0",
    "glob-parent": "^6.0.1",
    "ws": "^8.21.0",
    "serialize-javascript": "^7.0.3",
    "uuid": "^11.1.1"
  }
